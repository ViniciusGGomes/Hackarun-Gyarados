    {
      "name": "Admin - Equipamentos (exige login)",
      "description": "Atendente e Gestor têm as mesmas permissões aqui.",
      "item": [
        {
          "name": "Agenda do dia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/agenda?date={{date}}&equipmentType={{equipmentType}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "agenda"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "equipmentType",
                  "value": "{{equipmentType}}"
                }
              ]
            },
            "description": "Mostra os blocos do dia com unidades livres e as reservas (qualquer status). Guarda em {{reservationId}} o id da primeira reserva \"reserved\" encontrada."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setUTCDate(d.getUTCDate() + 1);",
                  "const sunday = d.getUTCDay() === 0;",
                  "d.setUTCHours(sunday ? 17 : 13, 0, 0, 0);",
                  "pm.collectionVariables.set('startAt', d.toISOString());",
                  "pm.collectionVariables.set('date', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().slots || [];",
                  "for (const s of slots) { const r = s.reservations.find(x => x.status === 'reserved'); if (r) { pm.collectionVariables.set('reservationId', r.id); break; } }"
                ]
              }
            }
          ]
        },
        {
          "name": "Agenda de hoje",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/agenda?date={{todayLocal}}&equipmentType={{equipmentType}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "agenda"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{todayLocal}}"
                },
                {
                  "key": "equipmentType",
                  "value": "{{equipmentType}}"
                }
              ]
            },
            "description": "Use esta para a retirada: só é possível retirar do início do bloco até o prazo de tolerância (15 min). Guarda {{reservationId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('todayLocal', new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().slots || [];",
                  "for (const s of slots) { const r = s.reservations.find(x => x.status === 'reserved'); if (r) { pm.collectionVariables.set('reservationId', r.id); break; } }"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar retirada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/reservations/{{reservationId}}/pickup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "reservations",
                "{{reservationId}}",
                "pickup"
              ]
            },
            "description": "{{reservationId}} é o id da SOLICITAÇÃO (o mesmo da agenda). Só vale com status reserved, entre o início do bloco e o prazo. O corpo é opcional; o horário é sempre o do servidor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentChecked\": true,\n  \"notes\": \"Retirada no balcão do SAC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ou 409 (fora da janela/status)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar devolução",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/reservations/{{reservationId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "reservations",
                "{{reservationId}}",
                "return"
              ]
            },
            "description": "Só vale com status picked_up (faça a retirada antes). Libera a unidade.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conditionNotes\": \"Equipamento em bom estado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ou 409 (status)', () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem token (deve dar 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/agenda?date={{date}}&equipmentType=wheelchair",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "agenda"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                },
                {
                  "key": "equipmentType",
                  "value": "wheelchair"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}