          "name": "Disponibilidade de um equipamento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/equipment/{{equipmentType}}/availability?date={{date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "equipment",
                "{{equipmentType}}",
                "availability"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{date}}"
                }
              ]
            },
            "description": "equipmentType: wheelchair ou stroller. A data vem do script (amanhã).",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date();",
                  "d.setUTCDate(d.getUTCDate() + 1);",
                  "const sunday = d.getUTCDay() === 0;",
                  "d.setUTCHours(sunday ? 17 : 13, 0, 0, 0);",
                  "pm.collectionVariables.set('startAt', d.toISOString());",
                  "pm.collectionVariables.set('date', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
